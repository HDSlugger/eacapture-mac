+    /** Copies a finished recording into the preserve folder, if one is set. */
+    private function preserveRecording(string $path, array $job): void
+    {
+        if ($this->preserveDir === null) {
+            return;
+        }
+
+        $name = basename((string)parse_url($job['UploadPut'], PHP_URL_PATH));
+        if ($name === '' || $name === '.' || $name === '/') {
+            $name = 'capture.dbg';
+        }
+        // The timestamp keeps repeated upload names (e.g. "...-eas.dbg") from colliding.
+        $dest = $this->preserveDir . '/' . gmdate('Ymd-His', $job['CaptureTime']) . 'Z_' . $name;
+
+        if (@copy($path, $dest)) {
+            $this->log('Preserved recording as ' . basename($dest));
+        } else {
+            $this->log("Could not preserve recording to $dest");
+        }
+    }
